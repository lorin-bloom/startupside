# Required for live research (get one at https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Optional — models. A cheap model gathers facts with web search; a stronger
# one writes the snapshot and bull vs. bear analysis. About $0.11 per report.
# RESEARCH_MODEL=claude-haiku-5-5
# ANALYSIS_MODEL=claude-sonnet-5-5

# Spending and abuse controls (defaults shown)
# DAILY_SPEND_CAP_USD=2         # global cap per UTC day, all visitors combined
# REPORT_RESERVE_USD=0.4        # budget held while a report runs
# ANALYZE_LIMIT_PER_HOUR=3      # new live reports per visitor per hour
# ASK_LIMIT_PER_HOUR=20         # follow-up questions per visitor per hour
# REPORT_CACHE_DAYS=14          # how long a finished report is reused
# DEEPEN_LIMIT_PER_HOUR=12      # "Research deeper" clicks per visitor per hour
# LIVE_RESEARCH_ENABLED=true    # set to false to allow sample reports only

# Optional but recommended on Vercel: shared storage so the cache, rate limits
# and spending cap work across all server instances. Adding an Upstash Redis
# database from the Vercel Marketplace fills these in automatically.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=   # lets `node scripts/usage.mjs` read the usage log
